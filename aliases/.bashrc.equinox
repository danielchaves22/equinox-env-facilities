gitCheckout() {
    git checkout "$1"
}

gitCheckoutPull() {
    git checkout "$1"
    git pull origin "$1"
}

gitPull() {
    git pull origin "$1"
}

unalias sshcp 2>/dev/null || true
function sshcp {
    if [ -z "$1" ]; then
        echo "Uso: sshcp ARQUIVO"
        return 1
    fi

    scp "$1" restapi@tec.comexdez.com.br
}

pullDir() {
    if [ -z "$1" ]; then
        echo "Uso: pullDir DIRETÓRIO"
        return 1
    fi
    
    echo "Entrando no diretório $1..."
    cd "$1" || { echo "Erro ao entrar no diretório $1"; return 1; }
    
    echo "Fazendo pull do repositório Git..."
    git pull
    
    echo "Voltando ao diretório anterior..."
    cd - || { echo "Erro ao voltar ao diretório anterior"; return 1; }
}

flutterBuildAndRun() {
    flutter clean
    flutter pub get
    flutter pub run build_runner build --delete-conflicting-outputs
    flutter run
}

flutterRun() {
    flutter pub get
    flutter run
}

pushRemote() {
    local remote_name=$1
    local branch_name=$2

    if git remote | grep -q "^${remote_name}$"; then
        
        # Se a branch foi especificada, usa ela, senão usa a branch atual
        if [ -n "$branch_name" ]; then
            git push "$remote_name" "$branch_name"
        else
            git push "$remote_name"
        fi
    else
        echo "Erro: Remote '${remote_name}' não existe"
        echo "Remotes disponíveis:"
        git remote -v
        return 1
    fi
}


pushRemotes() {
   echo "***********  ORIGIN ***********"
   pushRemote origin

    echo ""
    echo ""

    echo "***********  BITBUCKET ***********"
    pushRemote bitbucket

    echo ""
    echo ""

    echo "***********  GITHUB ***********"
    pushRemote github
}

netStat() {
    netstat -ano | findstr  0.0.0.0:$1
}

pKill() {
    MSYS2_ARG_CONV_EXCL='*' taskkill.exe /PID "$1" /F
}

npmRunDev() {
    current_dir=$(pwd)
    cd "$1" || return 1
    npm run dev
    cd $current_dir
}

pnpmRunDev() {
    current_dir=$(pwd)
    cd "$1" || return 1
    corepack pnpm dev
    cd "$current_dir"
}

getMinttyRuntimeDir() {
    local runtime_dir="${TMPDIR:-/tmp}/equinox-env-facilities/mintty"
    mkdir -p "$runtime_dir"
    echo "$runtime_dir"
}

readMinttyRecordField() {
    local record_dir="$1"
    local field_name="$2"
    local file_path="$record_dir/$field_name"

    if [ -f "$file_path" ]; then
        tr -d '\r' < "$file_path"
    fi
}

getProcessInfoField() {
    local pid="$1"
    local column="$2"

    if [ -z "$pid" ]; then
        return 1
    fi

    ps -l -p "$pid" 2>/dev/null | awk -v target_column="$column" 'NR==2 { print $target_column }'
}

getProcessGroupId() {
    getProcessInfoField "$1" 3
}

getProcessParentId() {
    getProcessInfoField "$1" 2
}

getWinProcessId() {
    getProcessInfoField "$1" 4
}

isPosixPidRunning() {
    local pid="$1"

    if [ -z "$pid" ]; then
        return 1
    fi

    kill -0 "$pid" >/dev/null 2>&1
}

isMinttyWindowRunningForRecord() {
    local record_dir="$1"
    local mintty_pid=""
    local running_winpid=""

    mintty_pid=$(readMinttyRecordField "$record_dir" "mintty.pid")
    if isPosixPidRunning "$mintty_pid"; then
        return 0
    fi

    running_winpid=$(findRunningMinttyWinPidForRecord "$record_dir")
    [ -n "$running_winpid" ]
}

isTrackedMinttyRecordActiveFast() {
    local record_dir="$1"
    local shell_pid=""
    local mintty_pid=""

    shell_pid=$(readMinttyRecordField "$record_dir" "shell.pid")
    mintty_pid=$(readMinttyRecordField "$record_dir" "mintty.pid")

    if isPosixPidRunning "$shell_pid"; then
        return 0
    fi

    if isPosixPidRunning "$mintty_pid"; then
        return 0
    fi

    if { [ -z "$shell_pid" ] || [ -z "$mintty_pid" ]; } && wasMinttyRecordStartedRecently "$record_dir"; then
        return 0
    fi

    return 1
}

findRunningMinttyWinPidForRecord() {
    local record_dir="$1"
    local find_script="$record_dir/find-mintty.ps1"
    local find_script_windows=""

    if [ ! -f "$find_script" ]; then
        return 1
    fi

    find_script_windows=$(cygpath -w "$find_script")
    MSYS2_ARG_CONV_EXCL='*' powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$find_script_windows" "$record_dir" 2>/dev/null | tr -d '\r' | head -n 1
}

wasMinttyRecordStartedRecently() {
    local record_dir="$1"
    local started_at=""
    local now=""

    started_at=$(readMinttyRecordField "$record_dir" "started_at")
    if [ -z "$started_at" ]; then
        return 1
    fi

    now=$(date +%s)
    [ $((now - started_at)) -lt 10 ]
}

isTrackedMinttyRecordActive() {
    local record_dir="$1"
    local running_winpid=""

    if isTrackedMinttyRecordActiveFast "$record_dir"; then
        return 0
    fi

    running_winpid=$(findRunningMinttyWinPidForRecord "$record_dir")
    if [ -n "$running_winpid" ]; then
        return 0
    fi

    return 1
}

cleanupTrackedMinttyRecords() {
    local runtime_dir=""
    local record_dir=""

    runtime_dir=$(getMinttyRuntimeDir)

    for record_dir in "$runtime_dir"/launch.*; do
        [ -d "$record_dir" ] || continue

        if ! isTrackedMinttyRecordActive "$record_dir"; then
            rm -rf "$record_dir"
        fi
    done
}

waitForTrackedMinttyExit() {
    local record_dir="$1"
    local seconds="${2:-1}"
    local counter=0
    local max_attempts=1

    max_attempts=$(awk -v secs="$seconds" 'BEGIN { value = int((secs * 2) + 0.999); if (value < 1) value = 1; print value }')

    while [ "$counter" -lt "$max_attempts" ]; do
        if ! isTrackedMinttyRecordActiveFast "$record_dir"; then
            return 0
        fi

        sleep 0.5
        counter=$((counter + 1))
    done

    return 1
}

createTrackedMinttyLaunchScript() {
    local record_dir="$1"
    local launch_script="$record_dir/launch.sh"
    local close_script="$record_dir/close-mintty.ps1"
    local find_script="$record_dir/find-mintty.ps1"

    if [ -z "$record_dir" ] || [ ! -d "$record_dir" ]; then
        echo "Registro mintty invalido."
        return 1
    fi

    cat > "$launch_script" <<EOF
#!/usr/bin/env bash

record_dir="\$1"
command_file="\$record_dir/command"
bashrc_path="\$2"

get_process_info_field() {
    local pid="\$1"
    local column="\$2"

    if [ -z "\$pid" ]; then
        return 1
    fi

    ps -l -p "\$pid" 2>/dev/null | awk -v target_column="\$column" 'NR==2 { print \$target_column }'
}

if [ -z "\$record_dir" ] || [ ! -d "\$record_dir" ]; then
    echo "Registro mintty invalido."
    exit 1
fi

if [ ! -f "\$command_file" ]; then
    echo "Comando rastreado nao encontrado."
    exit 1
fi

shopt -s expand_aliases

if [ -n "\$bashrc_path" ] && [ -f "\$bashrc_path" ]; then
    source "\$bashrc_path" >/dev/null 2>&1
fi

shell_pid="\$\$"
shell_pgid=\$(get_process_info_field "\$shell_pid" 3)
mintty_pid=\$(get_process_info_field "\$shell_pid" 2)
mintty_winpid=\$(get_process_info_field "\$mintty_pid" 4)

printf '%s' "\$shell_pid" > "\$record_dir/shell.pid"
printf '%s' "\$shell_pgid" > "\$record_dir/shell.pgid"
printf '%s' "\$mintty_pid" > "\$record_dir/mintty.pid"
printf '%s' "\$mintty_winpid" > "\$record_dir/mintty.winpid"

trap 'exit 130' INT
trap 'exit 143' TERM

comando=\$(cat "\$command_file")
eval "\$comando"

status=\$?
if [ "\$status" -eq 130 ] || [ "\$status" -eq 143 ]; then
    exit "\$status"
fi

exec bash -i
EOF

    chmod +x "$launch_script"

    cat > "$close_script" <<'EOF'
param(
    [Parameter(Mandatory = $true)]
    [string]$RecordDir
)

Get-CimInstance Win32_Process |
    Where-Object { $_.Name -eq 'mintty.exe' -and $_.CommandLine -like ('*' + $RecordDir + '*') } |
    ForEach-Object {
        Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue
    }
EOF

    cat > "$find_script" <<'EOF'
param(
    [Parameter(Mandatory = $true)]
    [string]$RecordDir
)

Get-CimInstance Win32_Process |
    Where-Object { $_.Name -eq 'mintty.exe' -and $_.CommandLine -like ('*' + $RecordDir + '*') } |
    Select-Object -ExpandProperty ProcessId
EOF
}

listTrackedMintty() {
    local runtime_dir=""
    local record_dir=""
    local found=0

    runtime_dir=$(getMinttyRuntimeDir)

    for record_dir in "$runtime_dir"/launch.*; do
        [ -d "$record_dir" ] || continue

        found=1

        local app_id=""
        local title=""
        local command=""
        local shell_pid=""
        local mintty_pid=""
        local status="stale"

        app_id=$(readMinttyRecordField "$record_dir" "app_id")
        title=$(readMinttyRecordField "$record_dir" "title")
        command=$(readMinttyRecordField "$record_dir" "command")
        shell_pid=$(readMinttyRecordField "$record_dir" "shell.pid")
        mintty_pid=$(readMinttyRecordField "$record_dir" "mintty.pid")

        if isTrackedMinttyRecordActive "$record_dir"; then
            status="active"
        fi

        echo "status=$status | app=$app_id | title=$title | shell_pid=$shell_pid | mintty_pid=$mintty_pid | command=$command"
    done

    if [ "$found" -eq 0 ]; then
        echo "Nenhuma janela mintty rastreada."
    fi
}

recordMatchesMinttyPattern() {
    local record_dir="$1"
    local pattern="$2"
    local app_id=""
    local title=""
    local command=""

    app_id=$(readMinttyRecordField "$record_dir" "app_id")
    title=$(readMinttyRecordField "$record_dir" "title")
    command=$(readMinttyRecordField "$record_dir" "command")

    printf '%s\n%s\n%s\n' "$app_id" "$title" "$command" | grep -qiF -- "$pattern"
}

listChildProcessIds() {
    local parent_pid="$1"

    if [ -z "$parent_pid" ]; then
        return 0
    fi

    ps -l 2>/dev/null | awk -v target_parent="$parent_pid" 'NR > 1 && $2 == target_parent { print $1 }'
}

listProcessTreeIds() {
    local parent_pid="$1"
    local child_pid=""

    if [ -z "$parent_pid" ]; then
        return 0
    fi

    echo "$parent_pid"

    for child_pid in $(listChildProcessIds "$parent_pid"); do
        listProcessTreeIds "$child_pid"
    done
}

listProcessTreeWinPids() {
    local parent_pid="$1"
    local posix_pid=""
    local winpid=""

    for posix_pid in $(listProcessTreeIds "$parent_pid"); do
        winpid=$(getWinProcessId "$posix_pid")
        if [ -n "$winpid" ]; then
            echo "$winpid"
        fi
    done
}

sendSignalToProcessTree() {
    local signal_name="$1"
    local parent_pid="$2"
    local child_pid=""

    if [ -z "$parent_pid" ]; then
        return 0
    fi

    for child_pid in $(listChildProcessIds "$parent_pid"); do
        sendSignalToProcessTree "$signal_name" "$child_pid"
    done

    if isPosixPidRunning "$parent_pid"; then
        kill "-$signal_name" "$parent_pid" >/dev/null 2>&1 || true
    fi
}

sendSignalToProcessGroup() {
    local signal_name="$1"
    local process_group_id="$2"

    if [ -z "$process_group_id" ]; then
        return 1
    fi

    kill "-$signal_name" -- "-$process_group_id" >/dev/null 2>&1 || true
}

sendInterruptToProcessTree() {
    sendSignalToProcessTree INT "$1"
}

isWinPidRunning() {
    local winpid="$1"

    if [ -z "$winpid" ]; then
        return 1
    fi

    MSYS2_ARG_CONV_EXCL='*' tasklist.exe /FI "PID eq $winpid" 2>/dev/null | tr -d '\r' | grep -qE "[[:space:]]$winpid[[:space:]]"
}

areAllWinPidsStopped() {
    local winpid=""

    for winpid in "$@"; do
        if isWinPidRunning "$winpid"; then
            return 1
        fi
    done

    return 0
}

killWinPidTree() {
    local winpid="$1"

    if [ -z "$winpid" ]; then
        return 0
    fi

    MSYS2_ARG_CONV_EXCL='*' taskkill.exe /PID "$winpid" /T /F >/dev/null 2>&1 || true
}

stopTrackedMinttyRecord() {
    local record_dir="$1"
    local title=""
    local shell_pid=""
    local mintty_pid=""
    local shell_pgid=""
    local mintty_winpid=""
    local close_script="$record_dir/close-mintty.ps1"
    local close_script_windows=""
    local winpid=""
    local mintty_running=1
    local -a app_winpids=()
    local -a tracked_winpids=()

    title=$(readMinttyRecordField "$record_dir" "title")
    shell_pid=$(readMinttyRecordField "$record_dir" "shell.pid")
    mintty_pid=$(readMinttyRecordField "$record_dir" "mintty.pid")
    shell_pgid=$(readMinttyRecordField "$record_dir" "shell.pgid")
    mintty_winpid=$(readMinttyRecordField "$record_dir" "mintty.winpid")
    if [ -z "$mintty_winpid" ]; then
        mintty_winpid=$(findRunningMinttyWinPidForRecord "$record_dir")
    fi

    while read -r winpid; do
        [ -n "$winpid" ] || continue
        app_winpids+=("$winpid")
    done < <(listProcessTreeWinPids "$shell_pid" | awk '!seen[$0]++')

    tracked_winpids=("${app_winpids[@]}")
    if [ -n "$mintty_winpid" ]; then
        tracked_winpids+=("$mintty_winpid")
    fi

    if [ -n "$shell_pgid" ]; then
        sendSignalToProcessGroup INT "$shell_pgid"
    elif [ -n "$shell_pid" ]; then
        kill -INT "$shell_pid" >/dev/null 2>&1 || true
    fi

    sleep 0.2

    if ! isTrackedMinttyRecordActiveFast "$record_dir" && areAllWinPidsStopped "${tracked_winpids[@]}"; then
        rm -rf "$record_dir"
        echo "Janela '$title' encerrada."
        return 0
    fi

    for winpid in "${app_winpids[@]}"; do
        [ "$winpid" = "$mintty_winpid" ] && continue
        killWinPidTree "$winpid"
    done

    if [ -n "$mintty_winpid" ]; then
        killWinPidTree "$mintty_winpid"
    fi

    sleep 0.2

    if ! isTrackedMinttyRecordActive "$record_dir" && areAllWinPidsStopped "${tracked_winpids[@]}"; then
        rm -rf "$record_dir"
        echo "Janela '$title' encerrada."
        return 0
    fi

    if [ -f "$close_script" ]; then
        close_script_windows=$(cygpath -w "$close_script")
        MSYS2_ARG_CONV_EXCL='*' powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$close_script_windows" "$record_dir" >/dev/null 2>&1 || true
        sleep 0.2
        if ! isTrackedMinttyRecordActive "$record_dir" && areAllWinPidsStopped "${tracked_winpids[@]}"; then
            rm -rf "$record_dir"
            echo "Janela '$title' encerrada."
            return 0
        fi
    fi

    if [ -n "$shell_pgid" ]; then
        sendSignalToProcessGroup TERM "$shell_pgid"
        sleep 0.2
        sendSignalToProcessGroup KILL "$shell_pgid"
    elif [ -n "$shell_pid" ]; then
        kill -TERM "$shell_pid" >/dev/null 2>&1 || true
        sleep 0.2
        kill -KILL "$shell_pid" >/dev/null 2>&1 || true
    fi

    for winpid in "${app_winpids[@]}"; do
        [ "$winpid" = "$mintty_winpid" ] && continue
        killWinPidTree "$winpid"
    done

    if [ -n "$mintty_winpid" ]; then
        killWinPidTree "$mintty_winpid"
    fi

    sleep 0.2

    if ! isTrackedMinttyRecordActive "$record_dir" && areAllWinPidsStopped "${tracked_winpids[@]}"; then
        rm -rf "$record_dir"
        echo "Janela '$title' encerrada."
        return 0
    fi

    echo "Falha ao encerrar '$title'."
    return 1
}

stopTrackedMintty() {
    local pattern="$1"
    local runtime_dir=""
    local record_dir=""
    local has_exact_app_match=0
    local found=0
    local failed=0
    local record_app_id=""

    if [ -z "$pattern" ]; then
        echo "Uso: mintstop PADRAO"
        return 1
    fi

    runtime_dir=$(getMinttyRuntimeDir)

    for record_dir in "$runtime_dir"/launch.*; do
        [ -d "$record_dir" ] || continue

        record_app_id=$(readMinttyRecordField "$record_dir" "app_id")
        if [ "$record_app_id" = "$pattern" ]; then
            has_exact_app_match=1
            break
        fi
    done

    for record_dir in "$runtime_dir"/launch.*; do
        [ -d "$record_dir" ] || continue

        if [ "$has_exact_app_match" -eq 1 ]; then
            record_app_id=$(readMinttyRecordField "$record_dir" "app_id")
            [ "$record_app_id" = "$pattern" ] || continue
        else
            recordMatchesMinttyPattern "$record_dir" "$pattern" || continue
        fi

        found=1
        stopTrackedMinttyRecord "$record_dir" || failed=1
    done

    if [ "$found" -eq 0 ]; then
        echo "Nenhuma janela mintty rastreada encontrada para '$pattern'."
        return 1
    fi

    return "$failed"
}

stopAllTrackedMintty() {
    local runtime_dir=""
    local record_dir=""
    local found=0
    local failed=0

    runtime_dir=$(getMinttyRuntimeDir)

    for record_dir in "$runtime_dir"/launch.*; do
        [ -d "$record_dir" ] || continue

        found=1
        stopTrackedMinttyRecord "$record_dir" || failed=1
    done

    if [ "$found" -eq 0 ]; then
        echo "Nenhuma janela mintty rastreada."
    fi

    return "$failed"
}

resolveCloudflaredPath() {
    if command -v cloudflared >/dev/null 2>&1; then
        command -v cloudflared
        return 0
    fi

    if [ -n "$CLOUDFLARED_PATH" ] && [ -f "$CLOUDFLARED_PATH" ]; then
        echo "$CLOUDFLARED_PATH"
        return 0
    fi

    local default_path="/c/Users/Lenovo/AppData/Local/Microsoft/WinGet/Links/cloudflared.exe"
    if [ -f "$default_path" ]; then
        echo "$default_path"
        return 0
    fi

    echo "cloudflared nao encontrado"
    return 1
}

replaceOrAppendEnvVar() {
    local file_path="$1"
    local var_name="$2"
    local var_value="$3"

    if [ ! -f "$file_path" ]; then
        touch "$file_path"
    fi

    if grep -q "^${var_name}=" "$file_path"; then
        sed -i "s|^${var_name}=.*|${var_name}=\"${var_value}\"|" "$file_path"
    else
        echo "${var_name}=\"${var_value}\"" >> "$file_path"
    fi
}

extractQuickTunnelUrl() {
    local log_file="$1"
    if [ ! -f "$log_file" ]; then
        return 1
    fi

    grep -o 'https://[A-Za-z0-9-]*\.trycloudflare\.com' "$log_file" | tail -n 1
}

startQuickTunnelProcess() {
    local port="$1"
    local log_file="$2"
    rm -f "$log_file"

    bashCommand "cloudflared tunnel --url http://localhost:${port} 2>&1 | tee \"$log_file\"" "ZenitAgente Tunnel ${port}"
}

waitForQuickTunnelUrl() {
    local log_file="$1"
    local seconds="${2:-30}"
    local counter=0
    local found_url=""

    while [ "$counter" -lt "$seconds" ]; do
        found_url=$(extractQuickTunnelUrl "$log_file")
        if [ -n "$found_url" ]; then
            echo "$found_url"
            return 0
        fi

        sleep 1
        counter=$((counter + 1))
    done

    echo "Falha ao obter URL do Quick Tunnel a partir de $log_file"
    return 1
}

startZenitAgenteTunnels() {
    local backend_env="$ZENIT_AGENTE_PATH/apps/backend/.env"
    local web_env="$ZENIT_AGENTE_PATH/apps/web-connect/.env"
    local backend_log="$ZENIT_AGENTE_PATH/.cloudflared-backend.log"
    local web_log="$ZENIT_AGENTE_PATH/.cloudflared-web.log"
    local backend_url=""
    local web_url=""

    if [ ! -d "$ZENIT_AGENTE_PATH" ]; then
        echo "Diretorio do Zenit Agente nao encontrado: $ZENIT_AGENTE_PATH"
        return 1
    fi

    echo "Iniciando Quick Tunnel do backend na porta 3000..."
    startQuickTunnelProcess 3000 "$backend_log" || return 1
    backend_url=$(waitForQuickTunnelUrl "$backend_log" 40) || return 1

    echo "Iniciando Quick Tunnel do web-connect na porta 5173..."
    startQuickTunnelProcess 5173 "$web_log" || return 1
    web_url=$(waitForQuickTunnelUrl "$web_log" 40) || return 1

    replaceOrAppendEnvVar "$backend_env" "PUBLIC_BACKEND_URL" "$backend_url"
    replaceOrAppendEnvVar "$backend_env" "GOOGLE_REDIRECT_URI" "$backend_url/google/oauth/callback"
    replaceOrAppendEnvVar "$backend_env" "WEB_CONNECT_URL" "$web_url"
    replaceOrAppendEnvVar "$web_env" "VITE_BACKEND_URL" "$backend_url"

    echo ""
    echo "Backend tunnel: $backend_url"
    echo "Web tunnel: $web_url"
    echo ""
    echo "Arquivos atualizados:"
    echo " - $backend_env"
    echo " - $web_env"
    echo ""
    echo "Importante: cadastre ${backend_url}/google/oauth/callback como redirect URI autorizado no Google antes de usar o fluxo OAuth por esse tunnel."
}

startZenitAgenteStack() {
    startZenitAgenteTunnels || return 1
    zagr
}

stopZenitAgenteTunnels() {
    MSYS2_ARG_CONV_EXCL='*' taskkill.exe /IM cloudflared.exe /F >/dev/null 2>&1 || true

    if [ -d "$ZENIT_AGENTE_PATH" ]; then
        rm -f "$ZENIT_AGENTE_PATH"/.cloudflared-*.log
        rm -f "$ZENIT_AGENTE_PATH"/.cloudflared-*.pid
    fi

    echo "Tunnels do Zenit Agente encerrados."
}

showPid() {
    if [ -z "$1" ]; then
        echo "Uso: kill_port PORTA"
        return 1
    fi

    echo "Procurando processos na porta $1..."
    local results=$(netstat -ano | findstr "0.0.0.0:$1")

    if [ -n "$results" ]; then
        echo "$results"
        echo ""

        # Extrair todos os PIDs únicos
        local pids=$(echo "$results" | awk '{print $5}' | sort -u)

        echo "$pids"
    else
        echo "Nenhum processo encontrado na porta $1"
    fi
}

kill_port() {
    if [ -z "$1" ]; then
        echo "Uso: kill_port PORTA"
        return 1
    fi

    echo "Procurando processos na porta $1..."
    local results=$(netstat -ano | findstr "0.0.0.0:$1")
    
    if [ -n "$results" ]; then
        echo "$results"
        echo ""

        # Extrair todos os PIDs únicos
        local pids=$(echo "$results" | awk '{print $5}' | sort -u)

        for pid in $pids; do
            if [ -n "$pid" ] && [ "$pid" -gt 0 ] 2>/dev/null; then
                echo "Matando processo PID: $pid"
                pKill $pid
            fi
        done

        echo ""
        echo "Verificando se a porta $1 ainda está em uso..."
        local check=$(netstat -ano | findstr ":$1")
        if [ -z "$check" ]; then
            echo "✓ Porta $1 liberada com sucesso!"
        else
            echo "⚠ Ainda há processos na porta $1:"
            echo "$check"
        fi
    else
        echo "Nenhum processo encontrado na porta $1"
    fi
}

