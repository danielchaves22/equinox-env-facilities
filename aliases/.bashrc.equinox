#### COMEXDEZ WEB ####
comexdezWebSetConnection() {
    if [ -z "$1" ]; then
        echo "Informe o ambiente"
        return 1
    fi

    echo "Salvando diretório atual..."
    current_dir=$(pwd)
    echo "Indo para diretório cw..."
    cwdir
    echo "Indo para sub diretório de resources... "
    cd web-app/src/main/resources

    if [ "$1" == "prod" ]; then
    echo "Copiando conteúdo de properties.prod para properties..."
        cp -p "mybatis.properties.prod" "mybatis.properties" || return 1
    elif [ "$1" == "local" ]; then
        echo "Copiando conteúdo de properties.local para properties..."
        cp -p "mybatis.properties.local" "mybatis.properties" || return 1
    else
        echo "Ambiente informado é inválido ($1)"
        return 1
    fi

    echo "Voltando ao diretório atual..."

    cd $current_dir        
}


