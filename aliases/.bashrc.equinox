bashCommand() {
    local comando="$1"
    local titulo="${2:-$comando}"
    local app_id="${3:-manual}"
    local runtime_dir=""
    local record_dir=""
    local bootstrap_bashrc="$SCRIPT_PATH/.bashrc"
    
    local mintty_path="/c/Program Files/Git/usr/bin/mintty.exe"
    if [ ! -f "$mintty_path" ]; then
        echo "mintty nao encontrado em $mintty_path"
        return 1
    fi

    cleanupTrackedMinttyRecords
    runtime_dir=$(getMinttyRuntimeDir)
    record_dir=$(mktemp -d "$runtime_dir/launch.XXXXXX") || return 1

    printf '%s' "$app_id" > "$record_dir/app_id"
    printf '%s' "$titulo" > "$record_dir/title"
    printf '%s' "$comando" > "$record_dir/command"
    date +%s > "$record_dir/started_at"

    createTrackedMinttyLaunchScript "$record_dir" || {
        rm -rf "$record_dir"
        return 1
    }

    "$mintty_path" -h always -t "$titulo" /usr/bin/bash "$record_dir/launch.sh" "$record_dir" "$bootstrap_bashrc" >/dev/null 2>&1 &
    disown $! 2>/dev/null || true
    stty sane 2>/dev/null || true

    echo "Comando '$comando' enviado para nova janela '$titulo'."
}

