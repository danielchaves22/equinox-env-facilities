updateTestBranch() {
    local target_branch="$1"

    if [ -z "$target_branch" ]; then
        echo "Informe o branch a ser testado"
        return 1
    fi

    if ! git switch master; then
        echo "Nao foi possivel trocar para 'master'. Verifique se ha mudancas locais impedindo o checkout."
        return 1
    fi

    if ! git pull origin master; then
        echo "Nao foi possivel atualizar a branch 'master'."
        return 1
    fi

    if git show-ref --verify --quiet "refs/heads/$target_branch"; then
        if ! git switch "$target_branch"; then
            echo "Nao foi possivel trocar para '$target_branch'. Verifique se ha mudancas locais impedindo o checkout."
            return 1
        fi
    elif git ls-remote --exit-code --heads origin "$target_branch" >/dev/null 2>&1; then
        if ! git switch -c "$target_branch" --track "origin/$target_branch"; then
            echo "Nao foi possivel trocar para '$target_branch'."
            return 1
        fi
    else
        echo "Branch '$target_branch' nao encontrada localmente nem no remoto 'origin'."
        return 1
    fi

    if ! git pull origin "$target_branch"; then
        echo "Nao foi possivel atualizar a branch '$target_branch'."
        return 1
    fi
}

